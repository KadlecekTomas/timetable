# Docker Compose si interní adresu solveru nastaví samo.
# `npm run dev` používá lokální solver na http://127.0.0.1:8000.
# SOLVER_URL=https://solver.example.cz

# Volitelný název aplikace ve webovém rozhraní.
NEXT_PUBLIC_APP_NAME=Rozvrhář

# V prohlížeči se standardně používá same-origin cesta /solver.
# Nastavuje se jen při samostatném veřejném nasazení solveru.
# NEXT_PUBLIC_SOLVER_URL=https://solver.example.cz
