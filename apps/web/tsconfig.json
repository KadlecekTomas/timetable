{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/lib/local/api": ["./lib/local/api-school"],
      "@/lib/local/teaching-plan": ["./lib/local/teaching-plan-school"],
      "@/lib/import/teaching-plan-workbook": [
        "./lib/import/teaching-plan-workbook-school-final"
      ],
      "@/lib/import/staffing-workbook": [
        "./lib/import/staffing-workbook-school"
      ],
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
