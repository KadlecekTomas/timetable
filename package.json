{
  "name": "timetable",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.4.2",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @timetable/web",
    "lint": "npm run lint --workspace @timetable/web",
    "typecheck": "npm run typecheck --workspace @timetable/web",
    "test": "npm run test --workspace @timetable/web",
    "format": "prettier --write package.json apps/web apps/solver .github/workflows compose.yaml vercel.json",
    "format:check": "prettier --write apps/web/lib/local/teaching-plan-school-v3.ts && git diff -- apps/web/lib/local/teaching-plan-school-v3.ts && exit 1"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
