{
  "name": "timetable",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.4.2",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @timetable/web",
    "build": "npm run build --workspace @timetable/database && npm run build --workspace @timetable/web",
    "lint": "npm run lint --workspace @timetable/web",
    "typecheck": "npm run typecheck --workspace @timetable/database && npm run typecheck --workspace @timetable/web",
    "test": "npm run test --workspace @timetable/web",
    "format": "prettier --write apps packages package.json compose.yaml .github/workflows/ci.yml",
    "format:check": "prettier --check apps packages package.json compose.yaml .github/workflows/ci.yml",
    "db:generate": "npm run prisma:generate --workspace @timetable/database",
    "db:migrate": "npm run prisma:migrate --workspace @timetable/database",
    "db:studio": "npm run prisma:studio --workspace @timetable/database"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
